{
  "name": "tfvc-labels-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Azure DevOps extension for browsing TFVC labels",
  "scripts": {
    "build": "node scripts/build.mjs --mode=production",
    "build:dev": "node scripts/build.mjs --mode=development",
    "package": "npm run build && npx tfx-cli extension create --manifest-globs vss-extension.json --rev-version --output-path dist",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.270.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "azure-devops-ui": "^2.280.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^29.5.12",
    "@types/react": "^16.14.60",
    "@types/react-dom": "^16.9.24",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tfx-cli": "^0.17.0",
    "typescript": "^5.4.5"
  }
}
